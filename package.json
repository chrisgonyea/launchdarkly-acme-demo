{
  "name": "launchdarkly-acme-demo",
  "version": "1.0.0",
  "description": "ABC Shop: a sample e-commerce storefront showing LaunchDarkly release, remediation, targeting and experimentation.",
  "type": "module",
  "private": true,
  "scripts": {
    "build:sdk": "esbuild public/sdk-entry.js --bundle --format=esm --outfile=public/vendor/launchdarkly.js --log-level=warning",
    "prestart": "npm run build:sdk",
    "start": "node server.js",
    "simulate": "node scripts/simulate-traffic.js",
    "test": "./scripts/smoke-test.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@launchdarkly/js-client-sdk": "4.13.0",
    "@launchdarkly/node-server-sdk": "9.15.0",
    "dotenv": "^16.4.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
