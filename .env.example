# Copy this file to .env and fill in your own values.  (cp .env.example .env)

# REQUIRED. LaunchDarkly > Project settings > Environments > your environment > Client-side ID
LD_CLIENT_SIDE_ID=

# OPTIONAL (Part 1 automated remediation). The "turn flag OFF" generic trigger URL
# for the recommendations-carousel flag. Leave blank to fire the trigger by hand with curl.
LD_CAROUSEL_OFF_TRIGGER_URL=

# OPTIONAL (Experimentation). Server-side SDK key, used only by `npm run simulate`.
# LaunchDarkly > Project settings > Environments > your environment > SDK key. Keep it secret.
LD_SDK_KEY=

# OPTIONAL. Port for the local web server.
PORT=3000
