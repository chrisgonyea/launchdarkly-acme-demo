# Copy this file to .env and fill in your own values.  (cp .env.example .env)

# REQUIRED. LaunchDarkly > Project settings > Environments > your environment > Client-side ID
LD_CLIENT_SIDE_ID=

# OPTIONAL (Part 1 automated remediation). Generic trigger URLs for the
# recommendations-carousel flag. Treat them like passwords.
# OFF: the watchdog turns the flag off when the carousel keeps failing.
#      Leave blank to fire the trigger by hand with curl instead.
LD_CAROUSEL_OFF_TRIGGER_URL=
# ON:  the watchdog turns the flag back on once the service passes 3 health
#      checks in a row. Leave blank to have a person turn it back on.
LD_CAROUSEL_ON_TRIGGER_URL=

# OPTIONAL. Port for the local web server.
PORT=3000
